{
  "passages": [
    {
      "id": "1",
      "label": "1",
      "speaker": {
        "greek": "Στρεψιάδης",
        "korean": "스트렙시아데스"
      },
      "greekText": "ἰοὺ ἰού:",
      "koreanText": "흑흑"
    },
    {
      "id": "2",
      "label": "2",
      "greekText": "ὦ Ζεῦ βασιλεῦ τὸ χρῆμα τῶν νυκτῶν ὅσον:",
      "koreanText": "제우스시여, 밤이 참 길군요,"
    },
    {
      "id": "3",
      "label": "3",
      "greekText": "ἀπέραντον. οὐδέποθ᾽ ἡμέρα γενήσεται;",
      "koreanText": "끝나지 않으니까요. 전혀 날이 밝지 않을까요?"
    },
    {
      "id": "4",
      "label": "4",
      "greekText": "καὶ μὴν πάλαι γ᾽ ἀλεκτρυόνος ἤκουσ᾽ ἐγώ:",
      "koreanText": "끝나지 않으니까요. 전혀 날이 밝지 않을까요?"
    },
    {
      "id": "5",
      "label": "5",
      "greekText": "οἱ δ᾽ οἰκέται ῥέγκουσιν: ἀλλ᾽ οὐκ ἂν πρὸ τοῦ.",
      "koreanText": "(준비중입니다)"
    },
    {
      "id": "6",
      "label": "6",
      "greekText": "ἀπόλοιο δῆτ᾽ ὦ πόλεμε πολλῶν οὕνεκα,",
      "koreanText": "(준비중입니다)"
    },
    {
      "id": "7",
      "label": "7",
      "greekText": "ὅτ᾽ οὐδὲ κολάσ᾽ ἔξεστί μοι τοὺς οἰκέτας.",
      "koreanText": "(준비중입니다)"
    },
    {
      "id": "8",
      "label": "8",
      "greekText": "ἀλλ᾽ οὐδ᾽ ὁ χρηστὸς οὑτοσὶ νεανίας",
      "koreanText": "(준비중입니다)"
    },
    {
      "id": "9",
      "label": "9",
      "greekText": "ἐγείρεται τῆς νυκτός, ἀλλὰ πέρδεται",
      "koreanText": "(준비중입니다)"
    },
    {
      "id": "10",
      "label": "10",
      "greekText": "10ἐν πέντε σισύραις ἐγκεκορδυλημένος.",
      "koreanText": "(준비중입니다)"
    },
    {
      "id": "11",
      "label": "11",
      "greekText": "ἀλλ᾽ εἰ δοκεῖ ῥέγκωμεν ἐγκεκαλυμμένοι.",
      "koreanText": "(준비중입니다)"
    },
    {
      "id": "12",
      "label": "12",
      "greekText": "ἀλλ᾽ οὐ δύναμαι δείλαιος εὕδειν δακνόμενος",
      "koreanText": "(준비중입니다)"
    },
    {
      "id": "13",
      "label": "13",
      "greekText": "ὑπὸ τῆς δαπάνης καὶ τῆς φάτνης καὶ τῶν χρεῶν",
      "koreanText": "(준비중입니다)"
    }
  ]
}
